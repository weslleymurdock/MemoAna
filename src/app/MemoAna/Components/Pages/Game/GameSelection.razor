@page "/selection"
@inject ILogger<GameSelection> logger
@inject IThemeService service

<div class="game-selection-page">
    <!-- Background -->
    <img src="images/empty.png"
         class="game-selection-background"
         alt="" />
    <!-- Difficulty -->
    <div class="difficulty-section">
        <MudText Class="difficulty-title">
            @Localizer["Difficulty"]
        </MudText>
        <MudToggleGroup CheckMark="true" Class="difficulty-options" T="string" @bind-Value="Difficulty" Vertical="false" Outlined Color="Color.Surface">
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("0")">@Localizer["Starter"]</MudToggleItem>
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("1")">@Localizer["Medium"]</MudToggleItem>
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("2")">@Localizer["Hard"]</MudToggleItem>
        </MudToggleGroup> 
        <MudElement HtmlTag="br" />
        <MudText Class="mode-title">
            @Localizer["GameMode"]
        </MudText>
        <MudToggleGroup CheckMark="true" Class="mode-options"T="string" @bind-Value="Mode" Vertical="false" Outlined Color="Color.Surface">
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("0")">@Localizer["IA"]</MudToggleItem>
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("1")">@Localizer["Time"]</MudToggleItem>
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("2")">@Localizer["PVP"]</MudToggleItem>
        </MudToggleGroup> 
    </div>
    <!-- Themes -->
    <div class="theme-section">
        <MudText Class="theme-title">@Localizer["ThemeSelection"]</MudText>
        @if (Themes.Count == 0)
        {
            <div class="theme-loading">
                <MudProgressCircular Indeterminate="true"
                                   Color="Color.Surface"
                                   Size="Size.Large" />
            </div>
        }
        else if (Themes.Count > 0)
        {
            <MudCarousel TData="CardThemeManifestDto"
                        ItemsSource="@Themes"
                        Class="theme-carousel"
                        Style="height:70vh;"
                        @bind-SelectedIndex="@selectedIndex"
                        AutoCycle="false"
                        ShowArrows="false"
                        ShowBullets="false"
                        BulletsColor="Color.Surface"
                        ArrowsColor="Color.Surface">

                <ItemTemplate>
                    @{var theme = context;}
                    <MudText Class="theme-name">
                        @context.ThemeName
                    </MudText>

                    <div class="theme-item" @onclick="@(() => SelectTheme(context))">
                        <div class="theme-preview @(IsSelected(context) ? "theme-preview-selected": "")">
                            <a href=@($"/game?Theme={context.CardThemeId}&Difficulty={Difficulty}&Mode={Mode}")>
                                <img src="@GetThemeImage(context)"
                                    class="theme-image"
                                    alt="@context.ThemeName" />
                            </a>
                    </div>
                </ItemTemplate>

            </MudCarousel>
        }
    </div>
</div>

@code {
    int selectedIndex; 
    bool IsBusy { get; set; } = false;
    CardThemeManifestDto? SelectedTheme { get; set; } = null!;
    ObservableCollection<CardThemeManifestDto> Themes { get; set; } = [];
    string Difficulty = "1";
    string Mode = "1";
    protected override async Task OnInitializedAsync()
    {
        await LoadThemesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PlayAsync()
    {
        try 
        {
            if (IsBusy) return; IsBusy = true;
            if (SelectedTheme == null) return;
            if (!int.TryParse(Difficulty, out int difficulty)) return;
            navigation.NavigateTo($"/game?Theme={SelectedTheme.CardThemeId}&Difficulty={difficulty}");
        }
        catch(Exception e)
        { 
            logger.LogError(e, "An error occurred: {Message}", e.Message);
        }
        finally 
        {
            IsBusy = false;
        }
    }

    private void SelectTheme(CardThemeManifestDto theme)
    {
        SelectedTheme = theme;
    }

    private bool IsSelected(CardThemeManifestDto theme)
    {
        return ReferenceEquals(SelectedTheme, theme);
    }

    private static string GetThemeImage(CardThemeManifestDto theme)
    {
        if (string.IsNullOrWhiteSpace(theme.PreviewBase64Image))
            return string.Empty;

        if (theme.PreviewBase64Image.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            return theme.PreviewBase64Image;

        return $"data:image/png;base64,{theme.PreviewBase64Image}";
    }

    private async Task LoadThemesAsync()
    {
        try
        {
            IsBusy = true;
            logger.LogInformation("Loading Themes...");
            IEnumerable<CardThemeManifestDto> themes = await service.GetThemesAsync();
            Themes.Clear();
            foreach (CardThemeManifestDto theme in themes)
            {
                Themes.Add(theme);
            }
            logger.LogInformation("Themes loaded.");
        }
        catch (Exception e)
        {
            logger.LogError(e, "Error when getting themes: {Message}", e.Message);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
 <style>
    .game-selection-page {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    /* 
    * Background
    */
    .game-selection-background {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;

        object-fit: fill;
        z-index: 0;
        user-select: none;
        pointer-events: none;
    }
    .theme-selection-background {
        position: fixed;
        width: 100%;
        height: 100%;
        object-fit: fill;
    }
    /* 
    * Difficulty
    */
    .difficulty-section {
        position: absolute;
        top: 150px;
        left: 50%;
        transform: translateX(-50%);
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        z-index: 2;
    }

    .difficulty-title {
        font-family: Bangpop;
        font-size: 32px;
        color: saddlebrown;
        text-align: center;
        text-shadow: 2px 2px 2px rgba(188, 143, 143, 0.8);
    }

    .difficulty-options {
        display: inline-flex;
        flex-direction: row;
        align-items: center;
        gap: 25px;
        width: 150px;
        margin-top: 20px;
    }

    .difficulty-mode-button {
        position: relative;
        background-color: burlywood;
        color: saddlebrown;
        box-shadow: 4px 4px 2px rgba(139, 69, 19, 0.8);
        overflow: hidden;
    }

    .difficulty-button-content {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .button-highlight {
        position: absolute;
        top: 2px;
        left: 2px;
        right: 2px;
        height: 25px;
        background-color: lightgoldenrodyellow;
        border-radius: 23px 23px 0 0;
        z-index: 0;
    }

    .difficulty-mode-button-text {
        position: relative;
        z-index: 1;
        font-family: Bangpop;
        font-size: 22px;
        color: saddlebrown;
        text-shadow: 4px 4px 2px rgba(250, 250, 210, 0.8);
    }

    /*
     * Game Mode
     */
 
    .mode-options {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 25px;
        width: 150px;
        margin-top: 20px;
    }
    
    .mode-title {
        font-family: Bangpop;
        font-size: 32px;
        color: saddlebrown;
        text-align: center;
        text-shadow: 2px 2px 2px rgba(188, 143, 143, 0.8);
    }
    /* 
     * Theme
     */
    .theme-section {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 20px;
        height: calc(100vh - 430px);
        min-height: 270px;
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 2;
    }
    .theme-carousel {
        width: 70dvw;
        height: 70dvh;
        flex: 1 1 auto;
        min-height: 0;
        margin-top: 30px;
        margin-bottom: 30px;
    }
    .theme-title {
        font-family: Bangpop;
        font-size: 22px;
        font-weight: bolder;
        color: saddlebrown;
        text-align: center;
    }
    .theme-item {
        width: 250px;
        height: 25svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin: auto;
        cursor: pointer;
        -webkit-user-select: none;
        user-select: none;
    }
    .theme-preview {
        width: 250px;
        height: 250px;
        padding: 5px;
        box-sizing: border-box;
        background-color: burlywood;
        border: 5px solid saddlebrown;
        border-radius: 10px;
        box-shadow: 3px 3px 3px rgba(0, 0, 0, 0.5);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .theme-preview:hover {
        transform: scale(1.03);
    }
    .theme-preview-selected {
        box-shadow: 0 0 0 3px lightgoldenrodyellow, 3px 3px 3px rgba(0, 0, 0, 0.5);
    }
    .theme-image {
        width: 100%;
        height: 100%;
        object-fit: fill;
        display: block;
    }
    .theme-name {
        font-family: Bangpop;
        font-size: 28px;
        color: saddlebrown;
        text-align: center;
        text-shadow: 2px 2px 1px rgba(250, 250, 210, 0.9);
    }

    /* 
     * Loading
     */
    .theme-loading {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* 
     * Font
     */
    @@font-face {
        font-family: Bangpop;
        src: url('/fonts/Bangpop.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    /* 
     * Responsive
     */
    @@media (max-height: 750px) {
        .difficulty-section {
            top: 120px;
        }

        .difficulty-options {
            gap: 12px;
        }

       .difficulty-mode-button {
            height: 44px;
            min-height: 44px;
        }

        .theme-section {
            height: calc(100vh - 350px);
        }
    }

    @@media (max-width: 600px) {
        .difficulty-section {
            top: 120px;
        }

        .difficulty-mode-button {
            width: 100%;
        }

        .difficulty-options {
            width: 60svw;
            gap: 15px;
        }

        .theme-section {
            bottom: 10px;
        }

        .theme-item {
            width: 175px;
        }

        .theme-preview {
            width: 175px;
            height: 175px;
        }
    }
</style>