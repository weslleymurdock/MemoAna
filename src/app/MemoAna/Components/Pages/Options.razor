@page "/options"

<MudPaper class="options-page">
    <MudImage Src="empty.png"
              Alt=""
              Class="options-background" />

    <MudCard class="options-container">
        <MudText Class="options-title">
            @Options
        </MudText>
        <MudButton Class="options-button" OnClick="SoundOnOffCommand">
            <div class="options-button-highlight"></div>
            <MudText Class="options-button-label">
                @MusicLabel
            </MudText>
        </MudButton>
        <MudButton Class="options-button" OnClick="SfxOnOffCommand">
            <div class="options-button-highlight"></div>
            <MudText Class="options-button-label">
                @SfxLabel
            </MudText>
        </MudButton>
        <MudButton Class="options-button" OnClick="CloudOnOffCommand">
            <div class="options-button-highlight"></div>
            <MudText Class="options-button-label">
                @CloudLabel
            </MudText>
        </MudButton>

        <MudButton Class="options-button" OnClick="ConfirmOnExitOnOffCommand">
            <div class="options-button-highlight"></div>
            <MudText Class="options-button-label">
                @ConfirmOnExitLabel
            </MudText>
        </MudButton>

        <MudButton Class="options-button" Href="/">
            <div class="options-button-highlight"></div>
            <MudText Class="options-button-label">
                @BackLabel
            </MudText>
        </MudButton>
    </MudCard>
</MudPaper>
@code {
    private string Options => Localizer["Options"];
    private string MusicLabel { get; set; } = string.Empty;
    private string SfxLabel { get; set; } = string.Empty;
    private string CloudLabel { get; set; } = string.Empty;
    private string ConfirmOnExitLabel { get; set; } = string.Empty;
    private string BackLabel { get; set; } = string.Empty;
    private Language language { get; set; } = 0;
    protected override async Task OnInitializedAsync()
    {
        InitializeLabels();
        await settings.LoadSettingsAsync();
    }
    GameSettingsDto Settings { get; set; } = new("", new(
        900, 
        true,
        true,
        true,
        true,
        true,
        0));
    private void InitializeLabels()
    {
        MusicLabel = Localizer["MusicLabel"];
        SfxLabel = Localizer["SfxLabel"];
        CloudLabel = Localizer["CloudLabel"];
        ConfirmOnExitLabel = Localizer["ConfirmOnExitLabel"];
        BackLabel = Localizer["BackLabel"];
    }
    private void SoundOnOffCommand()
    {
        Settings.Options.IsMusicEnabled = !Settings.Options.IsMusicEnabled;
        settings.SaveSettingsAsync(Settings);
    }
    private void SfxOnOffCommand()
    {
        Settings.Options.IsSfxEnabled = !Settings.Options.IsSfxEnabled;
        settings.SaveSettingsAsync(Settings);
    }
    private void CloudOnOffCommand()
    {
        Settings.Options.CloudSaveEnabled = !Settings.Options.CloudSaveEnabled;
        settings.SaveSettingsAsync(Settings);
    }
    private void ConfirmOnExitOnOffCommand()
    {
        Settings.Options.ConfirmOnExit = !Settings.Options.ConfirmOnExit;
        settings.SaveSettingsAsync(Settings);
    }
 
    async Task SaveOptions() => await settings.SaveSettingsAsync(Settings);
}
<style>
    .options-page {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 100vh;
        overflow: hidden;
    }

    .options-background {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;

        object-fit: cover;

        z-index: 0;
    }

    .options-container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 200px;
        margin: 120px auto 0;
        gap: 20px;
    }

    .options-title {
        width: 100%;
        margin-bottom: 0;
        color: burlywood;
        font-family: Gwenchana, sans-serif;
        font-size: 48px;
        font-weight: normal;
        line-height: 1;
        text-align: center;
        text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.8);
    }

    .options-button {
        position: relative;
        width: 200px;
        height: 50px;
        min-height: 50px;
        overflow: hidden;
        padding: 0;
        background-color: burlywood;
        border-radius: 25px;
        cursor: pointer;
        box-shadow: 4px 4px 2px rgba(139, 69, 19, 0.8);
        transition: transform 80ms ease, box-shadow 80ms ease;
    }

    .options-button:hover {
        transform: translateY(-1px);
        box-shadow: 4px 5px 3px rgba(139, 69, 19, 0.8);
    }

    .options-button:active {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 2px rgba(139, 69, 19, 0.8);
    }

    .options-button-highlight {
        position: absolute;
        top: 2px;
        left: 2px;
        right: 2px;
        height: 25px;
        background-color: lightgoldenrodyellow;
        border-radius: 2px;
        z-index: 0;
    }

    .options-button-label {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
        color: saddlebrown;
        font-family: Gwenchana, sans-serif;
        font-size: 22px;
        font-weight: normal;
        text-align: center;
        text-shadow: 4px 4px 2px rgba(250, 250, 210, 0.8);
    }

    @@media (max-height: 700px) {
        .options-container {
            margin-top: 60px;
            gap: 12px;
        }
    }
</style>