@page "/game"
@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable
@inject ILogger<Game> logger
@inject IThemeService themeService


@if(IsSelecting)
{
<div class="game-selection-page">
    <!-- Background -->
    <img src="images/empty.png"
         class="game-selection-background"
         alt="" />
    <!-- Difficulty -->
    <div class="difficulty-section">
        <MudText Class="difficulty-title">
            @Localizer["Difficulty"]
        </MudText>
        <MudToggleGroup CheckMark="true" Class="difficulty-options" T="string" @bind-Value="Difficulty" Vertical="false" Outlined Color="Color.Surface">
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("0")">@Localizer["Starter"]</MudToggleItem>
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("1")">@Localizer["Medium"]</MudToggleItem>
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("2")">@Localizer["Hard"]</MudToggleItem>
        </MudToggleGroup> 
        <MudElement HtmlTag="br" />
        <MudText Class="mode-title">
            @Localizer["GameMode"]
        </MudText>
        <MudToggleGroup CheckMark="true" Class="mode-options"T="string" @bind-Value="Mode" Vertical="false" Outlined Color="Color.Surface">
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("0")">@Localizer["IA"]</MudToggleItem>
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("1")">@Localizer["Time"]</MudToggleItem>
            <MudToggleItem Class="difficulty-mode-button" SelectedIcon="@Icons.Material.TwoTone.Check" Value="@("2")">@Localizer["PVP"]</MudToggleItem>
        </MudToggleGroup> 
    </div>
    <!-- Themes -->
    <div class="theme-section">
        <MudText Class="theme-title">@Localizer["ThemeSelection"]</MudText>
        @if (Themes.Count == 0)
        {
            <div class="theme-loading">
                <MudProgressCircular Indeterminate="true"
                                   Color="Color.Surface"
                                   Size="Size.Large" />
            </div>
        }
        else if (Themes.Count > 0)
        {
            <MudCarousel TData="CardThemeManifestDto"
                        ItemsSource="@Themes"
                        Class="theme-carousel"
                        Style="height:70vh;"
                        @bind-SelectedIndex="@selectedIndex"
                        AutoCycle="false"
                        ShowArrows="false"
                        ShowBullets="false"
                        BulletsColor="Color.Surface"
                        ArrowsColor="Color.Surface">

                <ItemTemplate>
                    @{var theme = context;}
                    <MudText Class="theme-name">
                        @context.ThemeName
                    </MudText>

                    <div class="theme-item" @onclick="@(() => SelectTheme(context))">
                        <div class="theme-preview @(IsSelected(context) ? "theme-preview-selected": "")">
                            <a href=@($"/game?Theme={context.CardThemeId}&Difficulty={Difficulty}&Mode={Mode}")>
                                <img src="@GetThemeImage(context)"
                                    class="theme-image"
                                    alt="@context.ThemeName" />
                            </a>
                    </div>
                </ItemTemplate>

            </MudCarousel>
        }
    </div>
</div>
}
else
{
<div class="game-page">
    <img src="images/empty.png" class="game-background" alt="" />

    @if (IsBusy)
    {
        <div class="loading-container">
            <MudProgressCircular Indeterminate="true"
                                 Size="Size.Large"
                                 Color="Color.Warning" />
            <MudText Class="loading-text">Preparando Tabuleiro...</MudText>
        </div>
    }
    else if (IsGameActive)
    {
        <div class="game-header">
            <MudText Class="game-header-score">@CurrentScore</MudText>
            <MudText Class="game-header-moves">@MovesCount</MudText>
            <MudText Class="game-header-time">@GameTime</MudText>
        </div>

        <div class="game-board" style="--columns: @Columns">
            @foreach (var card in Cards)
            {
                <div class="memory-card" @onclick="() => FlipCard(card.Key, card.Value)">
                    @if (!card.Value.IsFaceUp)
                    {
                        <img src="images/back.png" class="card-image card-back" alt="" />
                    }
                    else
                    {
                        <img src="@card.Value.CardImage" class="card-image card-face" alt="" />
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="statistics-container">
            <MudText Class="victory-text">@IsVictory</MudText>
            <div class="statistics-grid">
                <MudText Class="statistic-value statistic-left">@Statistics.ThemeName</MudText>
                <MudText Class="statistic-value statistic-right">@Statistics.Difficulty</MudText>
                <MudText Class="statistic-value statistic-center">@Statistics.PlayedAt</MudText>
                <MudText Class="statistic-label">ACERTOS</MudText>
                <MudText Class="statistic-value statistic-right">@Statistics.SuccessfulMoves</MudText>
                <MudText Class="statistic-label">ERROS</MudText>
                <MudText Class="statistic-value statistic-right">@Statistics.Mistakes</MudText>
                <MudText Class="statistic-label">SOMA</MudText>
                <MudText Class="statistic-value statistic-right">@Statistics.TotalMoves</MudText>
                <MudText Class="statistic-label">PONTOS</MudText>
                <MudText Class="statistic-value statistic-right">@CurrentScore</MudText>
                <MudText Class="statistic-label">TOTAL</MudText>
                <MudText Class="statistic-value statistic-right">@Statistics.FinalScore</MudText>
            </div>
        </div>

        <div class="game-actions">
            <MudButton Class="game-action-button" OnClick="GoToMain">INICIO</MudButton>
            <MudButton Class="game-action-button game-action-repeat" OnClick="RestartGame">REPETIR</MudButton>
        </div>
    }
</div>
}
@code {
    bool IsSelecting { get; set; } = true;

    [SupplyParameterFromQuery(Name = "Theme")]
    public string? ThemeParameter { get; set; }
 
    private bool IsBusy { get; set; }
    private string Theme { get; set; } = string.Empty;
    private string GameTime { get; set; } = "00:00";
    private string CurrentScore { get; set; } = "000";
    private string MovesCount { get; set; } = "0";
    private int Rows { get; set; } = 3;
    private int Columns { get; set; } = 4;
    private bool IsGameActive { get; set; }
    private string IsVictory { get; set; } = string.Empty;
    private GameStatisticsDto Statistics { get; set; } = GameStatisticsDto.Default;
    private ObservableCollection<KeyValuePair<int, MemoryCard>> Cards { get; } = [];
    private bool _isInitializing;
    private bool _eventsAttached;
    int selectedIndex; 
    CardThemeManifestDto? SelectedTheme { get; set; } = null!;
    ObservableCollection<CardThemeManifestDto> Themes { get; set; } = [];
    string Difficulty = "1";
    string Mode = "1";
    protected override async Task OnInitializedAsync()
    {
        await LoadThemesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PlayAsync()
    {
        try
        {
            if (IsBusy) return; IsBusy = true;
            if (SelectedTheme == null) return;
            if (!int.TryParse(Difficulty, out int difficulty)) return;
            navigation.NavigateTo($"/game?Theme={SelectedTheme.CardThemeId}&Difficulty={difficulty}");
        }
        catch (Exception e)
        {
            logger.LogError(e, "An error occurred: {Message}", e.Message);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void SelectTheme(CardThemeManifestDto theme)
    {
        SelectedTheme = theme;
    }

    private bool IsSelected(CardThemeManifestDto theme)
    {
        return ReferenceEquals(SelectedTheme, theme);
    }

    private static string GetThemeImage(CardThemeManifestDto theme)
    {
        if (string.IsNullOrWhiteSpace(theme.PreviewBase64Image))
            return string.Empty;

        if (theme.PreviewBase64Image.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            return theme.PreviewBase64Image;

        return $"data:image/png;base64,{theme.PreviewBase64Image}";
    }

    private async Task LoadThemesAsync()
    {
        try
        {
            IsBusy = true;
            logger.LogInformation("Loading Themes...");
            IEnumerable<CardThemeManifestDto> themes = await themeService.GetThemesAsync();
            Themes.Clear();
            foreach (CardThemeManifestDto theme in themes)
            {
                Themes.Add(theme);
            }
            logger.LogInformation("Themes loaded.");
        }
        catch (Exception e)
        {
            logger.LogError(e, "Error when getting themes: {Message}", e.Message);
        }
        finally
        {
            IsBusy = false;
        }
    }
  
    protected override async Task OnParametersSetAsync()
    {
        if (_isInitializing)
            return;

        if (string.IsNullOrWhiteSpace(ThemeParameter) || !int.TryParse(Difficulty, out _))
        {
            logger.LogWarning("Game route parameters are invalid. Theme: {Theme}, Difficulty: {Difficulty}", ThemeParameter, Difficulty);
            return;
        }

        _isInitializing = true;

        try
        {
            await InitializeGameAsync();
        }
        finally
        {
            _isInitializing = false;
        }
    }

    private async Task InitializeGameAsync()
    {
        IsBusy = true;
        IsGameActive = false;
        IsVictory = string.Empty;
        Statistics = GameStatisticsDto.Default;
        Cards.Clear();

        try
        {
            int level = int.Parse(Difficulty!);
            ConfigureGridGeometry(level);

            // GameSelection currently sends CardThemeId. GameService resolves themes by ThemeName,
            // so normalize the route value here. ThemeName is also accepted for compatibility.
            IReadOnlyCollection<CardThemeManifestDto> themes = await themeService.GetThemesAsync();
            CardThemeManifestDto? selectedTheme = themes.FirstOrDefault(x =>
                string.Equals(x.CardThemeId, ThemeParameter, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.ThemeName, ThemeParameter, StringComparison.OrdinalIgnoreCase));

            if (selectedTheme is null)
                throw new KeyNotFoundException($"Theme '{ThemeParameter}' was not found.");

            Theme = selectedTheme.ThemeName;

            AttachGameEvents();

            await game.StartGameAsync(level, Theme);

            foreach (KeyValuePair<int, MemoryCard> card in game.CurrentCards)
                Cards.Add(card);

            int remainingTime = level switch
            {
                0 => 75,
                1 => 100,
                2 => 120,
                _ => 75
            };

            GameTime = TimeSpan.FromSeconds(remainingTime).ToString(@"mm\:ss");
            CurrentScore = game.CurrentScore.ToString("D3");
            MovesCount = game.TotalMoves.ToString();
            IsGameActive = true;

            await audio.StopAsync();
            await audio.PlayMainGameAsync();

            logger.LogInformation("Game initialized. Theme: {Theme}, Difficulty: {Difficulty}, Cards: {CardCount}", Theme, level, Cards.Count);
        }
        catch (Exception e)
        {
            logger.LogError(e, "Error initializing game. Theme: {Theme}, Difficulty: {Difficulty}", ThemeParameter, Difficulty);
            IsGameActive = false;
        }
        finally
        {
            IsBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AttachGameEvents()
    {
        if (_eventsAttached)
            return;

        game.GameFinished += OnGameFinished;
        game.TimerTick += OnTimerTick;
        game.CardFlipped += OnCardFlipped;
        _eventsAttached = true;
    }

    private async Task FlipCard(int position, MemoryCard card)
    {
        if (IsBusy || !IsGameActive || card.IsFaceUp || card.IsMatched)
            return;

        IsBusy = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await game.FlipCardAsync(position, card);
            MovesCount = game.TotalMoves.ToString();
            CurrentScore = game.CurrentScore.ToString("D3");
        }
        finally
        {
            IsBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnTimerTick(object? sender, GameTickEventArgs gameTick)
    {
        _ = InvokeAsync(() =>
        {
            GameTime = gameTick.NextTime;
            CurrentScore = game.CurrentScore.ToString("D3");
            StateHasChanged();
        });
    }

    private void OnGameFinished(object? sender, GameStatisticsEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            IsGameActive = false;
            Statistics = new GameStatisticsDto(
                e.ThemeName,
                e.Difficulty,
                e.PlayedAt,
                e.IsVictory,
                e.RemainingSeconds,
                e.TotalMoves,
                e.SuccessfulMoves,
                e.Mistakes,
                e.FinalScore);
            IsVictory = e.IsVictory ? "+1 CONQUISTA!" : "DERROTA!";
            CurrentScore = e.FinalScore.ToString("D3");
            await audio.StopAsync();
            StateHasChanged();
        });
    }

    private void OnCardFlipped(object? sender, GameCardFlippedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ConfigureGridGeometry(int difficulty)
    {
        (Rows, Columns) = difficulty switch
        {
            0 => (4, 3),
            1 => (5, 4),
            2 => (6, 5),
            _ => (4, 3)
        };
    }

    private void GoToMain() => navigation.NavigateTo("/");

    private void RestartGame() => navigation.NavigateTo("/selection");

    private async Task CleanupGame()
    {
        if (_eventsAttached)
        {
            game.GameFinished -= OnGameFinished;
            game.TimerTick -= OnTimerTick;
            game.CardFlipped -= OnCardFlipped;
            _eventsAttached = false;
        }

        if (game is GameService service)
            service.ForceStopTimer();

        IsGameActive = false;
        await audio.StopAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await CleanupGame();
    }
}

<style>
    .game-selection-page { position: relative; width: 100%; height: 100vh; overflow: hidden; }
    .game-selection-background { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; z-index: 0; user-select: none; pointer-events: none; }
    .theme-selection-background { position: fixed; width: 100%; height: 100%; object-fit: fill; }
    .difficulty-section { position: absolute; top: 150px; left: 50%; transform: translateX(-50%); display: inline-flex; flex-direction: column; align-items: center; gap: 10px; z-index: 2; }
    .difficulty-title { font-family: Bangpop; font-size: 32px; color: saddlebrown; text-align: center; text-shadow: 2px 2px 2px rgba(188, 143, 143, 0.8); }
    .difficulty-options { display: inline-flex; flex-direction: row; align-items: center; gap: 25px; width: 150px; margin-top: 20px; }
    .difficulty-mode-button { position: relative; background-color: burlywood; color: saddlebrown; box-shadow: 4px 4px 2px rgba(139, 69, 19, 0.8); overflow: hidden; }
    .difficulty-button-content { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
    .button-highlight { position: absolute; top: 2px; left: 2px; right: 2px; height: 25px; background-color: lightgoldenrodyellow; border-radius: 23px 23px 0 0; z-index: 0; }
    .difficulty-mode-button-text { position: relative; z-index: 1; font-family: Bangpop; font-size: 22px; color: saddlebrown; text-shadow: 4px 4px 2px rgba(250, 250, 210, 0.8); }
    .mode-options { display: flex; flex-direction: row; align-items: center; gap: 25px; width: 150px; margin-top: 20px; }
    .mode-title { font-family: Bangpop; font-size: 32px; color: saddlebrown; text-align: center; text-shadow: 2px 2px 2px rgba(188, 143, 143, 0.8); }
    .theme-section { position: absolute; left: 0; right: 0; bottom: 20px; height: calc(100vh - 430px); min-height: 270px; display: flex; flex-direction: column; align-items: center; z-index: 2; }
    .theme-carousel { width: 70dvw; height: 70dvh; flex: 1 1 auto; min-height: 0; margin-top: 30px; margin-bottom: 30px; }
    .theme-title { font-family: Bangpop; font-size: 22px; font-weight: bolder; color: saddlebrown; text-align: center; }
    .theme-item { width: 250px; height: 25svh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; margin: auto; cursor: pointer; -webkit-user-select: none; user-select: none; }
    .theme-preview { width: 250px; height: 250px; padding: 5px; box-sizing: border-box; background-color: burlywood; border: 5px solid saddlebrown; border-radius: 10px; box-shadow: 3px 3px 3px rgba(0, 0, 0, 0.5); transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .theme-preview:hover { transform: scale(1.03); }
    .theme-preview-selected { box-shadow: 0 0 0 3px lightgoldenrodyellow, 3px 3px 3px rgba(0, 0, 0, 0.5); }
    .theme-image { width: 100%; height: 100%; object-fit: fill; display: block; }
    .theme-name { font-family: Bangpop; font-size: 28px; color: saddlebrown; text-align: center; text-shadow: 2px 2px 1px rgba(250, 250, 210, 0.9); }
    .theme-loading { flex: 1; display: flex; align-items: center; justify-content: center; }
    @@font-face { font-family: Bangpop; src: url('/fonts/Bangpop.ttf') format('truetype'); font-weight: normal; font-style: normal; }
    @@media (max-height: 750px) { 
        .difficulty-section { top: 120px; }
        .difficulty-options { gap: 12px; }
        .difficulty-mode-button { height: 44px; min-height: 44px; }
        .theme-section { height: calc(100vh - 350px); }
    }
    @@media (max-width: 600px) { 
        .difficulty-section { top: 120px; }
        .difficulty-mode-button { width: 100%; }
        .difficulty-options { width: 60svw; gap: 15px; }
        .theme-section { bottom: 10px; }
        .theme-item { width: 175px; }
        .theme-preview { width: 175px; height: 175px; }
    }
    .game-page { position: relative; width: 100%; height: 100vh; overflow: hidden; }
    .game-background { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; z-index: 0; pointer-events: none; user-select: none; }
    .loading-container { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px; z-index: 10; }
    .loading-text { font-family: Bangpop; font-size: 20px; color: saddlebrown; text-shadow: 2px 2px 1px rgba(250,250,210,.9); }
    .game-header { position: absolute; top: 40px; left: 20px; right: 20px; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; z-index: 2; }
    .game-header-score, .game-header-moves, .game-header-time { font-family: Bangpop; font-size: 48px; color: lightgoldenrodyellow; line-height: 1; }
    .game-header-score { text-align: left; } .game-header-moves { text-align: center; } .game-header-time { text-align: right; }
    .game-board { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); display: grid; grid-template-columns: repeat(var(--columns),70px); gap: 10px; z-index: 2; }
    .memory-card { width: 70px; height: 90px; cursor: pointer; user-select: none; transition: transform .12s ease, filter .12s ease; }
    .memory-card:hover { filter: brightness(1.05); } .memory-card:active { transform: scale(.95); }
    .card-image { width: 100%; height: 100%; display: block; object-fit: cover; box-sizing: border-box; }
    .card-face { object-fit: contain; } .card-back { object-fit: cover; }
    .statistics-container { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); z-index: 2; min-width: 300px; text-align: center; }
    .victory-text { font-family: Bangpop; font-size: 36px; color: saddlebrown; text-shadow: 2px 2px 1px lightgoldenrodyellow; }
    .statistics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 20px; margin-top: 25px; }
    .statistic-label, .statistic-value { font-family: Bangpop; color: saddlebrown; font-size: 20px; }
    .statistic-left { text-align: left; } .statistic-right { text-align: right; } .statistic-center { grid-column: 1 / -1; text-align: center; }
    .game-actions { position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%); display: flex; gap: 25px; z-index: 3; }
    .game-action-button { min-width: 140px; background-color: burlywood; color: saddlebrown; font-family: Bangpop; box-shadow: 4px 4px 2px rgba(139,69,19,.8); }
</style>
