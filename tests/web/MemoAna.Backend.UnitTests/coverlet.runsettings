<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector
        friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>
            [MemoAna.Backend]MemoAna.Backend.Controllers.*,
            [MemoAna.Backend.Application]MemoAna.Backend.Application.*,
            [MemoAna.Backend.Domain]MemoAna.Backend.Domain.*,
            [MemoAna.Backend.Infrastructure]MemoAna.Backend.Infrastructure.*
          </Include>
          <Exclude>
            [MemoAna.Backend]Microsoft.AspNetCore.OpenApi.Generated*,
            [MemoAna.Backend]Microsoft.AspNetCore.Components.*.g__*,
            [MemoAna.Backend]Microsoft.Extensions.*.g__*,
            [MemoAna.Backend]System.*
            [Mediator.SourceGenerator]Mediator.*
          </Exclude>
          <ExcludeByAttribute>
            GeneratedCodeAttribute,
            ExcludeFromCodeCoverageAttribute
          </ExcludeByAttribute>
          <ExcludeByFile>
            **/*.g.cs,
            **/*.g.i.cs,
            **/obj/**/*.cs
          </ExcludeByFile>
          <ExcludeAssembliesWithoutSources>MissingAll</ExcludeAssembliesWithoutSources>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
